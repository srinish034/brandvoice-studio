# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Required. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. The model this project was built and tested with.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Port for the Express server (hosts like Render set this for you).
PORT=3000

# Optional. Comma-separated frontend origins allowed to call the API.
# Local dev defaults to http://localhost:5173. Leave unset in production when
# Express serves the frontend itself (same origin). Set it only if the
# frontend is hosted on a different domain, e.g. https://your-app.vercel.app
# CORS_ORIGIN=https://your-frontend.example.com

# Optional. Limit on /api/generate calls per IP (defaults: 20 per 15 minutes).
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=900000

# Frontend (build time). Only needed if the frontend and API are on DIFFERENT
# domains. Leave unset for local dev (Vite proxies /api) and single-service deploys.
# VITE_API_BASE_URL=https://your-api.example.com
